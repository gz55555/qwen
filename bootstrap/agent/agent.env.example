# llmmon GPU agent configuration — copied to /opt/llmmon-agent/agent.env by install.sh.
# No secrets live here.
LLMMON_INSTANCE_ID=vast-01
LLMMON_LISTEN_ADDR=127.0.0.1          # loopback only — reached via the central SSH tunnel
LLMMON_LISTEN_PORT=9835
LLMMON_NODE_EXPORTER_ADDR=127.0.0.1:9100
LLMMON_POLL_INTERVAL=15               # seconds between NVML/cgroup reads (min 5)
LLMMON_PROCESS_ALLOWLIST=ollama,llama-server  # comma-separated comm names; llama-server = Ollama inference runner
LLMMON_LOG_LEVEL=INFO
