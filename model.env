# What this repo sets up. Copy the repo for another model and change these.
MODEL=qwen3.5:27b
MODEL_SIZE_HINT="≈17.5 GB"
NUM_CTX=16384                 # context the model is warmed with (match your clients to avoid reloads)
KEEP_ALIVE=30m
OLLAMA_VERSION=0.40.5
OLLAMA_ENV='OLLAMA_KEEP_ALIVE="30m"'     # extra env for 'ollama serve' (supervisor syntax: K="v",K2="v")

# Central monitoring server
INSTANCE_ID=vast-01                 # logical id on the central server (must exist there)
CENTRAL_URL=https://llms.bytepaths.io

# Pinned monitoring agent dependency
NODE_EXPORTER_VERSION=1.9.1
NODE_EXPORTER_SHA256=becb950ee80daa8ae7331d77966d94a611af79ad0d3307380907e0ec08f5b4e8
